ENVIRONMENT=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection — either set DATABASE_URL (for Render/Neon) OR POSTGRES_* parameters
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=zeroday
POSTGRES_PASSWORD=zeroday_pw
POSTGRES_DB=zeroday_db

MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=zeroday_docs

# Redis connection — either set REDIS_URL (for Render/Upstash) OR REDIS_HOST/PORT/PASSWORD
# REDIS_URL=rediss://default:password@host:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=2048
MODEL_ARTIFACT_DIR=/data/model_artifacts
